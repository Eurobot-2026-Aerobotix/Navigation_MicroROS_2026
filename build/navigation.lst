 500:Core/Src/navigation.c **** int orientate(float orientation, int8_t is_radian){
 501:Core/Src/navigation.c **** 	orientation = (is_radian)? orientation : deg_to_rad(orientation);
 502:Core/Src/navigation.c **** 	if (fabs(orientation - current_phi) > deg_to_rad(0.5) ){
 503:Core/Src/navigation.c **** 		float angle = orientation - current_phi;
 504:Core/Src/navigation.c **** 		if (angle > PI){
 505:Core/Src/navigation.c **** 			angle -= 2*PI;
 506:Core/Src/navigation.c **** 		}else if (angle < -PI){
 507:Core/Src/navigation.c **** 			angle += 2*PI;
 508:Core/Src/navigation.c **** 		}
 509:Core/Src/navigation.c **** 		previous_speed_control_time = micros();
 510:Core/Src/navigation.c **** 		return rotate(angle, 1);
 511:Core/Src/navigation.c **** 	}
 512:Core/Src/navigation.c **** 	return 0;
 513:Core/Src/navigation.c **** }
