 305:Core/Src/navigation.c **** int rotate(float angle, int8_t is_radian){
 306:Core/Src/navigation.c **** 	reset_speed_control_variables();
 307:Core/Src/navigation.c **** 	float rotating_breaking_acceleration = -4;
 308:Core/Src/navigation.c **** 	angle = is_radian? angle: deg_to_rad(angle);
 309:Core/Src/navigation.c **** 	float arc_length = (dead_wheels_spacing/2) * angle;
 310:Core/Src/navigation.c **** 
 311:Core/Src/navigation.c **** 	direction_R = SGN(arc_length);
 312:Core/Src/navigation.c **** 	direction_L = -direction_R;
