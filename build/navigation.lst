 617:Core/Src/navigation.c **** int go_to(float x, float y, float speed, int direction, int8_t is_smooth){
 618:Core/Src/navigation.c **** 	while(!is_idle()){
 619:Core/Src/navigation.c **** 		delay(10);
 620:Core/Src/navigation.c **** 	}
