 629:Core/Src/navigation.c **** 		if (control_loop_state == SHUTDOWN ){
 630:Core/Src/navigation.c **** 			return 0;
 631:Core/Src/navigation.c **** 		}
 632:Core/Src/navigation.c **** 
 633:Core/Src/navigation.c **** 	}
 634:Core/Src/navigation.c **** 	delay(50);
 635:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 636:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 637:Core/Src/navigation.c **** 	}
 638:Core/Src/navigation.c **** 	return 0;
 639:Core/Src/navigation.c **** }
