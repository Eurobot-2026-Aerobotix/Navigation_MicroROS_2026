 321:Core/Src/navigation.c **** int move_forward_with_deviation(float distance, float deviation, float speed){
 322:Core/Src/navigation.c **** 	//!!!!!!!!! ma3ach nest7a99oha
 323:Core/Src/navigation.c **** 	reset_speed_control_variables();
 324:Core/Src/navigation.c **** 	// there is a lotta math going on here, can't explain it in code
 325:Core/Src/navigation.c **** 	float radius = ( SQR(distance/2) + SQR(deviation) ) / ( 2*deviation );
