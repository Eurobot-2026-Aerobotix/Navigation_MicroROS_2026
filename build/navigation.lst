 503:Core/Src/navigation.c **** 		}
 504:Core/Src/navigation.c **** 	}
 505:Core/Src/navigation.c **** 	delay(50);
 506:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 507:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 508:Core/Src/navigation.c **** 	}
 509:Core/Src/navigation.c **** 	return 0;
 510:Core/Src/navigation.c **** }
