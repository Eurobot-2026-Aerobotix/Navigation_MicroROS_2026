 341:Core/Src/navigation.c **** 		if (wheel_state_R == ACCELERATING && x > x1 ){
 342:Core/Src/navigation.c **** 			wheel_state_R = CRUISING;
 343:Core/Src/navigation.c **** 			wheel_state_L = CRUISING;
 344:Core/Src/navigation.c **** 		}else if (wheel_state_R == CRUISING && x > x2){
 345:Core/Src/navigation.c **** 			wheel_state_R = CONTROLLED_BREAK;
