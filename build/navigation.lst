 318:Core/Src/navigation.c **** int move_forward_with_deviation(float distance, float deviation, float speed){
 319:Core/Src/navigation.c **** 	//!!!!!!!!! ma3ach nest7a99oha
 320:Core/Src/navigation.c **** 	reset_speed_control_variables();
 321:Core/Src/navigation.c **** 	// there is a lotta math going on here, can't explain it in code
 322:Core/Src/navigation.c **** 	float radius = ( SQR(distance/2) + SQR(deviation) ) / ( 2*deviation );
 323:Core/Src/navigation.c **** 	float alpha = atan( (distance/2) / ( fabs(radius) - fabs(deviation) ) ) * SGN(deviation);
 324:Core/Src/navigation.c **** 	float arc_length = 2 * fabs(alpha * radius);
 325:Core/Src/navigation.c **** 	float arc_length_R = fabs( 2 * alpha * ( radius - dead_wheels_spacing/2) );
 326:Core/Src/navigation.c **** 	float arc_length_L = fabs( 2 * alpha * ( radius + dead_wheels_spacing/2) );
