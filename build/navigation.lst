 327:Core/Src/navigation.c **** 
 328:Core/Src/navigation.c **** 	wheel_state_R = ACCELERATING;
 329:Core/Src/navigation.c **** 	wheel_state_L = ACCELERATING;
 330:Core/Src/navigation.c **** 	trajectory = ROTATING;
 331:Core/Src/navigation.c **** 	control_loop_state = SPEED;
