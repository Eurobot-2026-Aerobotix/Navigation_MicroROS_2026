 540:Core/Src/navigation.c **** int go_to(float x, float y, float speed, int direction, int8_t is_smooth){
 541:Core/Src/navigation.c **** 	while(!is_idle()){
 542:Core/Src/navigation.c **** 		delay(10);
 543:Core/Src/navigation.c **** 	}
 544:Core/Src/navigation.c **** 	float angle = normalize_angle( get_angle_to(x, y) + PI*(1 - direction)/2 );
 545:Core/Src/navigation.c **** 	while (fabs(normalize_angle(angle - current_phi)) > deg_to_rad(1)){
 546:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 547:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 548:Core/Src/navigation.c **** 			return 0;
 549:Core/Src/navigation.c **** 		}
 550:Core/Src/navigation.c **** 		while(!is_idle()){
 551:Core/Src/navigation.c **** 			delay(10);
 552:Core/Src/navigation.c **** 		}
 553:Core/Src/navigation.c **** 		if (control_loop_state == SHUTDOWN ){
 554:Core/Src/navigation.c **** 			return 0;
 555:Core/Src/navigation.c **** 		}
 556:Core/Src/navigation.c **** 
 557:Core/Src/navigation.c **** 	}
 558:Core/Src/navigation.c **** 	delay(50);
 559:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 560:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 561:Core/Src/navigation.c **** 	}
 562:Core/Src/navigation.c **** 	return 0;
 563:Core/Src/navigation.c **** }
