 595:Core/Src/navigation.c **** 	int right_stopped = 0;
 596:Core/Src/navigation.c **** 	int left_stopped = 0;
 597:Core/Src/navigation.c **** 	while((!right_stopped) || (!left_stopped)){
 598:Core/Src/navigation.c **** 		delay(10);
