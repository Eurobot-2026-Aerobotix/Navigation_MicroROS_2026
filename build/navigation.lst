 500:Core/Src/navigation.c **** 	orientation = (is_radian)? orientation : deg_to_rad(orientation);
 501:Core/Src/navigation.c **** 	while(!is_idle()){
 502:Core/Src/navigation.c **** 		delay(10);
 503:Core/Src/navigation.c **** 	};
