 583:Core/Src/navigation.c **** 	int saved_encoder_count_R = encoder_count_R;
 584:Core/Src/navigation.c **** 	int saved_encoder_count_L = encoder_count_L;
 585:Core/Src/navigation.c **** 	control_loop_state = ACTIVATED;
 586:Core/Src/navigation.c **** 	PWM_L = 0;
 587:Core/Src/navigation.c **** 	PWM_R = 0;
