 621:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 622:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 623:Core/Src/navigation.c **** 			return 0;
 624:Core/Src/navigation.c **** 		}
 625:Core/Src/navigation.c **** 		while(!is_idle()){
 626:Core/Src/navigation.c **** 			delay(10);
 627:Core/Src/navigation.c **** 		}
 628:Core/Src/navigation.c **** 		if (control_loop_state == SHUTDOWN ){
 629:Core/Src/navigation.c **** 			return 0;
 630:Core/Src/navigation.c **** 		}
 631:Core/Src/navigation.c **** 
 632:Core/Src/navigation.c **** 	}
 633:Core/Src/navigation.c **** 	delay(50);
 634:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 635:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 636:Core/Src/navigation.c **** 	}
 637:Core/Src/navigation.c **** 	return 0;
 638:Core/Src/navigation.c **** }
