  91:Core/Src/navigation.c **** 	float x_closest = ( target_point_y - current_y + tan(current_phi)*current_x - tan(current_phi - PI
  92:Core/Src/navigation.c **** 	float y_closest = tan(current_phi)*(x_closest - current_x) + current_y;
