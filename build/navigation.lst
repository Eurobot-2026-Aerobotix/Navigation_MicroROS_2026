 518:Core/Src/navigation.c **** int orientate(float orientation, int8_t is_radian){
 519:Core/Src/navigation.c **** 	orientation = (is_radian)? orientation : deg_to_rad(orientation);
 520:Core/Src/navigation.c **** 	if (fabs(orientation - current_phi) > deg_to_rad(0.5) ){
 521:Core/Src/navigation.c **** 		float angle = orientation - current_phi;
 522:Core/Src/navigation.c **** 		if (angle > PI){
 523:Core/Src/navigation.c **** 			angle -= 2*PI;
 524:Core/Src/navigation.c **** 		}else if (angle < -PI){
 525:Core/Src/navigation.c **** 			angle += 2*PI;
 526:Core/Src/navigation.c **** 		}
 527:Core/Src/navigation.c **** 		previous_speed_control_time = micros();
 528:Core/Src/navigation.c **** 		return rotate(angle, 1);
 529:Core/Src/navigation.c **** 	}
 530:Core/Src/navigation.c **** 	return 0;
 531:Core/Src/navigation.c **** }
