  53:Core/Src/navigation.c **** 	float previous_distance_to_target = distance;
  54:Core/Src/navigation.c **** 	float x = 0;
  55:Core/Src/navigation.c **** 
  56:Core/Src/navigation.c **** 	wheel_state_R = ACCELERATING;
  57:Core/Src/navigation.c **** 	wheel_state_L = ACCELERATING;
  58:Core/Src/navigation.c **** 	trajectory = STRAIGHT;
  59:Core/Src/navigation.c **** 	control_loop_state = SPEED;
  60:Core/Src/navigation.c **** 	starting_phi = absolute_phi;
