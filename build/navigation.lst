 434:Core/Src/navigation.c **** int orientate(float orientation, int8_t is_radian, int8_t is_smooth){
 435:Core/Src/navigation.c **** 	simple_movement = 1;
 436:Core/Src/navigation.c **** 	orientation = (is_radian)? orientation : deg_to_rad(orientation);
