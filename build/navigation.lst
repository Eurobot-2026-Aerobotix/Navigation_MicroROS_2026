 140:Core/Src/navigation.c **** int move_forward(float distance, float speed, int8_t is_smooth){
 141:Core/Src/navigation.c **** 	float target_x = current_x + distance*cos(current_phi);
 142:Core/Src/navigation.c **** 	float target_y = current_y + distance*sin(current_phi);
 143:Core/Src/navigation.c **** 	return move_forward_full(distance, speed, target_x, target_y, is_smooth);
 144:Core/Src/navigation.c **** }
