 522:Core/Src/navigation.c **** int go_to(float x, float y, float speed, int direction, int8_t is_smooth){
 523:Core/Src/navigation.c **** 	while(!is_idle()){
 524:Core/Src/navigation.c **** 		delay(10);
 525:Core/Src/navigation.c **** 	}
 526:Core/Src/navigation.c **** 	float angle = normalize_angle( get_angle_to(x, y) + PI*(1 - direction)/2 );
