 287:Core/Src/navigation.c **** 	simple_movement = 1;
 288:Core/Src/navigation.c **** 	while(!is_idle()){
 289:Core/Src/navigation.c **** 		delay(10);
 290:Core/Src/navigation.c **** 	};
 291:Core/Src/navigation.c **** 	delay(200);
 292:Core/Src/navigation.c **** 	reset_speed_control_variables();
 293:Core/Src/navigation.c **** 	angle = is_radian? angle: deg_to_rad(angle);
 294:Core/Src/navigation.c **** 	float rotating_ramping_acceleration = MAX(300/(fabs(rad_to_deg(angle))/10.0 + 10), 10); // high ac
 295:Core/Src/navigation.c **** 	float rotating_breaking_acceleration = MIN(-120/(fabs(rad_to_deg(angle))/3.0 + 10), -4); // same l
 296:Core/Src/navigation.c **** 	float arc_length = (dead_wheels_spacing/2) * angle;
 297:Core/Src/navigation.c **** 
 298:Core/Src/navigation.c **** 	direction_R = SGN(arc_length);
 299:Core/Src/navigation.c **** 	direction_L = -direction_R;
 300:Core/Src/navigation.c **** 
 301:Core/Src/navigation.c **** 	// all of these formulas are derived from a ramp graph: speed = f(distance)
