  30:Core/Src/navigation.c **** int move_forward(float distance, float speed){
  31:Core/Src/navigation.c **** 	direction_R = 1;
  32:Core/Src/navigation.c **** 	direction_L = 1;
  33:Core/Src/navigation.c **** 
  34:Core/Src/navigation.c **** 	// all of these formulas are derived from a ramp graph: speed = f(distance)
  35:Core/Src/navigation.c **** 	float x1 = speed/ramping_acceleration;
  36:Core/Src/navigation.c **** 	float x2 = speed/breaking_acceleration + distance;
  37:Core/Src/navigation.c **** 
  38:Core/Src/navigation.c **** 	if (x2 <= x1){ // correcting the cruising speed if it is too high to reach using the current ramp 
  39:Core/Src/navigation.c **** 		float intersection_x = (breaking_acceleration*distance)/(breaking_acceleration - ramping_accelera
  40:Core/Src/navigation.c **** 		float intersection_speed = ramping_acceleration * intersection_x;
  41:Core/Src/navigation.c **** 		speed = 0.9 * intersection_speed;
  42:Core/Src/navigation.c **** 		x1 = speed/ramping_acceleration;
  43:Core/Src/navigation.c **** 		x2 = speed/breaking_acceleration + distance;
  44:Core/Src/navigation.c **** 	}
  45:Core/Src/navigation.c **** 
  46:Core/Src/navigation.c **** 	cruise_speed_R = speed;
  47:Core/Src/navigation.c **** 	cruise_speed_L = speed;
  48:Core/Src/navigation.c **** 	float target_point_x = current_x + distance*cos(current_phi);
  49:Core/Src/navigation.c **** 	float target_point_y = current_y + distance*sin(current_phi);
  50:Core/Src/navigation.c **** 	float distance_to_target = distance;
  51:Core/Src/navigation.c **** 	float previous_distance_to_target = distance;
  52:Core/Src/navigation.c **** 	float x = 0;
  53:Core/Src/navigation.c **** 
  54:Core/Src/navigation.c **** 	wheel_state_R = ACCELERATING;
  55:Core/Src/navigation.c **** 	wheel_state_L = ACCELERATING;
  56:Core/Src/navigation.c **** 	trajectory = STRAIGHT;
  57:Core/Src/navigation.c **** 	control_loop_state = SPEED;
  58:Core/Src/navigation.c **** 	starting_phi = absolute_phi;
  59:Core/Src/navigation.c **** 	float lane_correction_term;
  60:Core/Src/navigation.c **** 	float phase_two_distance = 30;
  61:Core/Src/navigation.c **** 	while (distance_to_target > phase_two_distance){
  62:Core/Src/navigation.c **** 		x = distance - distance_to_target;
