 646:Core/Src/navigation.c **** 	while (fabs(normalize_angle(angle - current_phi)) > deg_to_rad(1)){
 647:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 648:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
