 622:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 623:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 624:Core/Src/navigation.c **** 			return 0;
 625:Core/Src/navigation.c **** 		}
 626:Core/Src/navigation.c **** 		while(!is_idle()){
 627:Core/Src/navigation.c **** 			delay(10);
