 527:Core/Src/navigation.c **** int go_to(float x, float y, float speed, int direction, int8_t is_smooth){
 528:Core/Src/navigation.c **** 	while(!is_idle()){
 529:Core/Src/navigation.c **** 		delay(10);
 530:Core/Src/navigation.c **** 	}
 531:Core/Src/navigation.c **** 	float angle = normalize_angle( get_angle_to(x, y) + PI*(1 - direction)/2 );
 532:Core/Src/navigation.c **** 	while (fabs(normalize_angle(angle - current_phi)) > deg_to_rad(1)){
 533:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 534:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 535:Core/Src/navigation.c **** 			return 0;
 536:Core/Src/navigation.c **** 		}
 537:Core/Src/navigation.c **** 		while(!is_idle()){
 538:Core/Src/navigation.c **** 			delay(10);
 539:Core/Src/navigation.c **** 		}
 540:Core/Src/navigation.c **** 	}
 541:Core/Src/navigation.c **** 	delay(50);
 542:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 543:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 544:Core/Src/navigation.c **** 	}
 545:Core/Src/navigation.c **** 	return 0;
 546:Core/Src/navigation.c **** }
