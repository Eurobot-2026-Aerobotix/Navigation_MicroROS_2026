 229:Core/Src/navigation.c **** int rotate(float angle, int8_t is_radian, int8_t is_smooth){
 230:Core/Src/navigation.c **** 	apply_smooth_or_not(is_smooth);
 231:Core/Src/navigation.c **** 	while(!is_idle()){
 232:Core/Src/navigation.c **** 		delay(10);
 233:Core/Src/navigation.c **** 	};
 234:Core/Src/navigation.c **** 	reset_speed_control_variables();
 235:Core/Src/navigation.c **** 	angle = is_radian? angle: deg_to_rad(angle);
 236:Core/Src/navigation.c **** 	float rotating_ramping_acceleration = MAX(200/(fabs(rad_to_deg(angle))/10.0 + 10), 10); // high ac
 237:Core/Src/navigation.c **** 	float rotating_breaking_acceleration = MIN(-120/(fabs(rad_to_deg(angle))/3.0 + 10), -4); // same l
 238:Core/Src/navigation.c **** 	float arc_length = (dead_wheels_spacing/2) * angle;
 239:Core/Src/navigation.c **** 
 240:Core/Src/navigation.c **** 	direction_R = SGN(arc_length);
 241:Core/Src/navigation.c **** 	direction_L = -direction_R;
 242:Core/Src/navigation.c **** 
 243:Core/Src/navigation.c **** 	// all of these formulas are derived from a ramp graph: speed = f(distance)
 244:Core/Src/navigation.c **** 	float speed = rotating_speed;
 245:Core/Src/navigation.c **** 	float distance = fabs(arc_length);
 246:Core/Src/navigation.c **** 	float x1 = speed/rotating_ramping_acceleration;
 247:Core/Src/navigation.c **** 	float x2 = speed/rotating_breaking_acceleration + distance;
 248:Core/Src/navigation.c **** 
 249:Core/Src/navigation.c **** 	if (x2 <= x1){ // correcting the cruising speed if it is too high to reach using the current ramp 
 250:Core/Src/navigation.c **** 		float intersection_x = (rotating_breaking_acceleration*distance)/(rotating_breaking_acceleration 
 251:Core/Src/navigation.c **** 		float intersection_speed = rotating_ramping_acceleration * intersection_x;
 252:Core/Src/navigation.c **** 		speed = 0.9 * intersection_speed;
 253:Core/Src/navigation.c **** 		x1 = speed/rotating_ramping_acceleration;
 254:Core/Src/navigation.c **** 		x2 = speed/rotating_breaking_acceleration + distance;
 255:Core/Src/navigation.c **** 	}
 256:Core/Src/navigation.c **** 	acc_linearization_coef = sqrt(x1);
 257:Core/Src/navigation.c **** 
 258:Core/Src/navigation.c **** 	cruise_speed_R = speed * direction_R;
 259:Core/Src/navigation.c **** 	cruise_speed_L = speed * direction_L;
 260:Core/Src/navigation.c **** 
 261:Core/Src/navigation.c **** 	// I will track only the right wheel cause both wheels need to be in sync
 262:Core/Src/navigation.c **** 	float distance_to_target = distance;
 263:Core/Src/navigation.c **** 	float previous_distance_to_target = distance;
 264:Core/Src/navigation.c **** 	float x;
 265:Core/Src/navigation.c **** 	float target_phi = absolute_phi + angle;
 266:Core/Src/navigation.c **** 
 267:Core/Src/navigation.c **** 	// Yaw centering, preventing that a wheel goes faster than the other and moves the rotation axis a
 268:Core/Src/navigation.c **** 	float distance_traveled_R;
 269:Core/Src/navigation.c **** 	float distance_traveled_L;
 270:Core/Src/navigation.c **** 	const int32_t starting_encoder_count_R = encoder_count_R;
 271:Core/Src/navigation.c **** 	const int32_t starting_encoder_count_L = encoder_count_L;
 272:Core/Src/navigation.c **** 	float yaw_centering_term;
 273:Core/Src/navigation.c **** 
 274:Core/Src/navigation.c **** 	float phase_two_angle = 6* (fabs(angle)/PI);
ARM GAS  /var/folders/8w/hhxpmw5s5nq9vy9lt9w1v2xh0000gn/T//ccNMl4fb.s 			page 34


 275:Core/Src/navigation.c **** 
 276:Core/Src/navigation.c **** 	wheel_state_R = ACCELERATING;
 277:Core/Src/navigation.c **** 	wheel_state_L = ACCELERATING;
 278:Core/Src/navigation.c **** 	trajectory = ROTATING;
 279:Core/Src/navigation.c **** 	control_loop_state = SPEED;
 280:Core/Src/navigation.c **** 	while ( fabs(target_phi - absolute_phi) > deg_to_rad(phase_two_angle)  && !(distance_to_target > p
 281:Core/Src/navigation.c **** 		x = distance - distance_to_target;
 282:Core/Src/navigation.c **** 		x = MAX(distance - distance_to_target, 0);
 283:Core/Src/navigation.c **** 		if (wheel_state_R == ACCELERATING && x > x1 ){
 284:Core/Src/navigation.c **** 			wheel_state_R = CRUISING;
 285:Core/Src/navigation.c **** 			wheel_state_L = CRUISING;
 286:Core/Src/navigation.c **** 		}else if (wheel_state_R == CRUISING && x > x2){
 287:Core/Src/navigation.c **** 			wheel_state_R = CONTROLLED_BREAK;
 288:Core/Src/navigation.c **** 			wheel_state_L = CONTROLLED_BREAK;
 289:Core/Src/navigation.c **** 		}else if (wheel_state_R == EMERGENCY_BREAK){
 290:Core/Src/navigation.c **** 			emergency_break();
 291:Core/Src/navigation.c **** 			return 0;
 292:Core/Src/navigation.c **** 		}
 293:Core/Src/navigation.c **** 
 294:Core/Src/navigation.c **** 		distance_traveled_R = fabs(encoder_count_R - starting_encoder_count_R) * wheel_diameter_R * PI / 
 295:Core/Src/navigation.c **** 		distance_traveled_L = fabs(encoder_count_L - starting_encoder_count_L) * wheel_diameter_L * PI / 
 296:Core/Src/navigation.c **** 
 297:Core/Src/navigation.c **** 
 298:Core/Src/navigation.c **** 		speed = calculate_instant_target_speed_R_full(x, distance, rotating_ramping_acceleration, rotatin
 299:Core/Src/navigation.c **** 		yaw_centering_term = ( distance_traveled_R - distance_traveled_L ) * 0.2 / ( MAX(fabs(speed), 100
 300:Core/Src/navigation.c **** 		if (x < 0.1*x1){
 301:Core/Src/navigation.c **** 			yaw_centering_term = 0;
 302:Core/Src/navigation.c **** 		}
 303:Core/Src/navigation.c **** 		set_target_speeds(speed*(1 - yaw_centering_term) ,-speed* (1 + yaw_centering_term));
 304:Core/Src/navigation.c **** 		delay(4);
 305:Core/Src/navigation.c **** 		previous_distance_to_target = distance_to_target;
 306:Core/Src/navigation.c **** 		distance_to_target = (dead_wheels_spacing/2) * fabs(target_phi - absolute_phi);
