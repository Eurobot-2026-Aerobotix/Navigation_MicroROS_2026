  64:Core/Src/navigation.c **** 			wheel_state_R = CRUISING;
  65:Core/Src/navigation.c **** 			wheel_state_L = CRUISING;
  66:Core/Src/navigation.c **** 		}else if (wheel_state_R == CRUISING && x > x2){
