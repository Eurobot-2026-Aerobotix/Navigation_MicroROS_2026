 302:Core/Src/navigation.c **** 		float intersection_x = (rotating_breaking_acceleration*distance)/(rotating_breaking_acceleration 
 303:Core/Src/navigation.c **** 		float intersection_speed = rotating_ramping_acceleration * intersection_x;
