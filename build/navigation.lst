 113:Core/Src/navigation.c **** //			return 1;
 114:Core/Src/navigation.c **** //		}
 115:Core/Src/navigation.c **** 
 116:Core/Src/navigation.c **** 		send_values_to_usart(current_speed_L, current_speed_R, target_speed_L, target_speed_R);
 117:Core/Src/navigation.c **** 	}
 118:Core/Src/navigation.c **** 	stop_motors();
