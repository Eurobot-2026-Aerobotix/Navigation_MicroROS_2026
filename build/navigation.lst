 478:Core/Src/navigation.c **** int orientate(float orientation, int8_t is_radian, int8_t is_smooth){
 479:Core/Src/navigation.c **** 	orientation = (is_radian)? orientation : deg_to_rad(orientation);
 480:Core/Src/navigation.c **** 	while(!is_idle()){
 481:Core/Src/navigation.c **** 		delay(10);
 482:Core/Src/navigation.c **** 	};
