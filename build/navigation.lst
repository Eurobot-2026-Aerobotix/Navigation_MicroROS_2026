 589:Core/Src/navigation.c **** 		delay(10);
 590:Core/Src/navigation.c **** 	}
 591:Core/Src/navigation.c **** 	int speed_sign_R = SGN(current_speed_R);
 592:Core/Src/navigation.c **** 	int speed_sign_L = SGN(current_speed_L);
