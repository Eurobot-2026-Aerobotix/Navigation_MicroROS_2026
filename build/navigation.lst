 491:Core/Src/navigation.c **** int go_to(float x, float y, float speed, int direction, int8_t is_smooth){
 492:Core/Src/navigation.c **** 	while(!is_idle()){
 493:Core/Src/navigation.c **** 		delay(10);
 494:Core/Src/navigation.c **** 	}
 495:Core/Src/navigation.c **** 	float angle = normalize_angle( get_angle_to(x, y) + PI*(1 - direction)/2 );
 496:Core/Src/navigation.c **** 	while (fabs(normalize_angle(angle - current_phi)) > deg_to_rad(1)){
 497:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 498:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 499:Core/Src/navigation.c **** 			return 0;
 500:Core/Src/navigation.c **** 		}
 501:Core/Src/navigation.c **** 		while(!is_idle()){
 502:Core/Src/navigation.c **** 			delay(10);
