  31:Core/Src/navigation.c **** int move_forward(float distance, float speed){
  32:Core/Src/navigation.c **** 	reset_speed_control_variables();
  33:Core/Src/navigation.c **** 	direction_R = 1;
  34:Core/Src/navigation.c **** 	direction_L = 1;
  35:Core/Src/navigation.c **** 
  36:Core/Src/navigation.c **** 	// all of these formulas are derived from a ramp graph: speed = f(distance)
  37:Core/Src/navigation.c **** 	float x1 = speed/ramping_acceleration;
  38:Core/Src/navigation.c **** 	float x2 = speed/breaking_acceleration + distance;
  39:Core/Src/navigation.c **** 
  40:Core/Src/navigation.c **** 	if (x2 <= x1){ // correcting the cruising speed if it is too high to reach using the current ramp 
  41:Core/Src/navigation.c **** 		float intersection_x = (breaking_acceleration*distance)/(breaking_acceleration - ramping_accelera
  42:Core/Src/navigation.c **** 		float intersection_speed = ramping_acceleration * intersection_x;
  43:Core/Src/navigation.c **** 		speed = 0.9 * intersection_speed;
  44:Core/Src/navigation.c **** 		x1 = speed/ramping_acceleration;
  45:Core/Src/navigation.c **** 		x2 = speed/breaking_acceleration + distance;
  46:Core/Src/navigation.c **** 	}
