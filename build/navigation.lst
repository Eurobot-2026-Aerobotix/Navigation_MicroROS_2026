 623:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 624:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 625:Core/Src/navigation.c **** 			return 0;
 626:Core/Src/navigation.c **** 		}
 627:Core/Src/navigation.c **** 		while(!is_idle()){
 628:Core/Src/navigation.c **** 			delay(10);
 629:Core/Src/navigation.c **** 		}
 630:Core/Src/navigation.c **** 		if (control_loop_state == SHUTDOWN ){
 631:Core/Src/navigation.c **** 			return 0;
 632:Core/Src/navigation.c **** 		}
 633:Core/Src/navigation.c **** 
 634:Core/Src/navigation.c **** 	}
 635:Core/Src/navigation.c **** 	delay(50);
 636:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 637:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 638:Core/Src/navigation.c **** 	}
 639:Core/Src/navigation.c **** 	return 0;
 640:Core/Src/navigation.c **** }
