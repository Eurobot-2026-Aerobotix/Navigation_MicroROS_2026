 529:Core/Src/navigation.c **** 			return 0;
 530:Core/Src/navigation.c **** 		}
 531:Core/Src/navigation.c **** 		while(!is_idle()){
 532:Core/Src/navigation.c **** 			delay(10);
 533:Core/Src/navigation.c **** 		}
 534:Core/Src/navigation.c **** 	}
 535:Core/Src/navigation.c **** 	delay(50);
 536:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 537:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 538:Core/Src/navigation.c **** 	}
 539:Core/Src/navigation.c **** 	return 0;
 540:Core/Src/navigation.c **** }
