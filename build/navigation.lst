 267:Core/Src/navigation.c **** int rotate(float angle, int8_t is_radian, int8_t is_smooth){
 268:Core/Src/navigation.c **** 	apply_smooth_or_not(is_smooth);
 269:Core/Src/navigation.c **** 	while(!is_idle()){
 270:Core/Src/navigation.c **** 		delay(10);
 271:Core/Src/navigation.c **** 	};
 272:Core/Src/navigation.c **** 	reset_speed_control_variables();
 273:Core/Src/navigation.c **** 	angle = is_radian? angle: deg_to_rad(angle);
 274:Core/Src/navigation.c **** 	float rotating_ramping_acceleration = MAX(200/(fabs(rad_to_deg(angle))/10.0 + 10), 10); // high ac
 275:Core/Src/navigation.c **** 	float rotating_breaking_acceleration = MIN(-120/(fabs(rad_to_deg(angle))/3.0 + 10), -4); // same l
 276:Core/Src/navigation.c **** 	float arc_length = (dead_wheels_spacing/2) * angle;
 277:Core/Src/navigation.c **** 
 278:Core/Src/navigation.c **** 	direction_R = SGN(arc_length);
 279:Core/Src/navigation.c **** 	direction_L = -direction_R;
 280:Core/Src/navigation.c **** 
 281:Core/Src/navigation.c **** 	// all of these formulas are derived from a ramp graph: speed = f(distance)
 282:Core/Src/navigation.c **** 	float speed = rotating_speed;
 283:Core/Src/navigation.c **** 	float distance = fabs(arc_length);
 284:Core/Src/navigation.c **** 	float x1 = speed/rotating_ramping_acceleration;
 285:Core/Src/navigation.c **** 	float x2 = speed/rotating_breaking_acceleration + distance;
 286:Core/Src/navigation.c **** 
 287:Core/Src/navigation.c **** 	if (x2 <= x1){ // correcting the cruising speed if it is too high to reach using the current ramp 
 288:Core/Src/navigation.c **** 		float intersection_x = (rotating_breaking_acceleration*distance)/(rotating_breaking_acceleration 
 289:Core/Src/navigation.c **** 		float intersection_speed = rotating_ramping_acceleration * intersection_x;
 290:Core/Src/navigation.c **** 		speed = 0.9 * intersection_speed;
 291:Core/Src/navigation.c **** 		x1 = speed/rotating_ramping_acceleration;
 292:Core/Src/navigation.c **** 		x2 = speed/rotating_breaking_acceleration + distance;
 293:Core/Src/navigation.c **** 	}
 294:Core/Src/navigation.c **** 	acc_linearization_coef = sqrt(x1);
ARM GAS  C:\Users\monji\AppData\Local\Temp\ccBLK7x3.s 			page 42


 295:Core/Src/navigation.c **** 
 296:Core/Src/navigation.c **** 	cruise_speed_R = speed * direction_R;
 297:Core/Src/navigation.c **** 	cruise_speed_L = speed * direction_L;
 298:Core/Src/navigation.c **** 
 299:Core/Src/navigation.c **** 	// I will track only the right wheel cause both wheels need to be in sync
 300:Core/Src/navigation.c **** 	float distance_to_target = distance;
 301:Core/Src/navigation.c **** 	float previous_distance_to_target = distance;
 302:Core/Src/navigation.c **** 	float x = 0;
 303:Core/Src/navigation.c **** 	float target_phi = absolute_phi + angle;
 304:Core/Src/navigation.c **** 
 305:Core/Src/navigation.c **** 	// Yaw centering, preventing that a wheel goes faster than the other and moves the rotation axis a
 306:Core/Src/navigation.c **** 	float distance_traveled_R;
 307:Core/Src/navigation.c **** 	float distance_traveled_L;
 308:Core/Src/navigation.c **** 	const int32_t starting_encoder_count_R = encoder_count_R;
 309:Core/Src/navigation.c **** 	const int32_t starting_encoder_count_L = encoder_count_L;
 310:Core/Src/navigation.c **** 	float yaw_centering_term;
 311:Core/Src/navigation.c **** 
 312:Core/Src/navigation.c **** 	float phase_two_angle = 6* (fabs(angle)/PI);
 313:Core/Src/navigation.c **** 
 314:Core/Src/navigation.c **** 	wheel_state_R = ACCELERATING;
 315:Core/Src/navigation.c **** 	wheel_state_L = ACCELERATING;
 316:Core/Src/navigation.c **** 	trajectory = ROTATING;
 317:Core/Src/navigation.c **** 	control_loop_state = SPEED;
 318:Core/Src/navigation.c **** 	while ( fabs(target_phi - absolute_phi) > deg_to_rad(phase_two_angle)  && !(distance_to_target > p
 319:Core/Src/navigation.c **** 		x = distance - distance_to_target;
 320:Core/Src/navigation.c **** 		x = MAX(distance - distance_to_target, 0);
 321:Core/Src/navigation.c **** 		if (wheel_state_R == ACCELERATING && x > x1 ){
 322:Core/Src/navigation.c **** 			wheel_state_R = CRUISING;
 323:Core/Src/navigation.c **** 			wheel_state_L = CRUISING;
 324:Core/Src/navigation.c **** 		}else if (wheel_state_R == CRUISING && x > x2){
