 150:Core/Src/navigation.c **** int move_forward(float distance, float speed, int8_t is_smooth){
 151:Core/Src/navigation.c **** 	float target_x = current_x + distance*cos(current_phi);
 152:Core/Src/navigation.c **** 	float target_y = current_y + distance*sin(current_phi);
 153:Core/Src/navigation.c **** 	return move_forward_full(distance, speed, target_x, target_y, is_smooth);
 154:Core/Src/navigation.c **** }
