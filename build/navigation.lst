 490:Core/Src/navigation.c **** int go_to(float x, float y, float speed, int direction, int8_t is_smooth){
 491:Core/Src/navigation.c **** 	while(!is_idle()){
 492:Core/Src/navigation.c **** 		delay(10);
 493:Core/Src/navigation.c **** 	}
 494:Core/Src/navigation.c **** 	float angle = normalize_angle( get_angle_to(x, y) + PI*(1 - direction)/2 );
 495:Core/Src/navigation.c **** 	while (fabs(normalize_angle(angle - current_phi)) > deg_to_rad(1)){
 496:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 497:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 498:Core/Src/navigation.c **** 			return 0;
 499:Core/Src/navigation.c **** 		}
 500:Core/Src/navigation.c **** 		while(!is_idle()){
 501:Core/Src/navigation.c **** 			delay(10);
 502:Core/Src/navigation.c **** 		}
ARM GAS  /var/folders/8w/hhxpmw5s5nq9vy9lt9w1v2xh0000gn/T//ccNMl4fb.s 			page 38


 503:Core/Src/navigation.c **** 	}
 504:Core/Src/navigation.c **** 	delay(50);
 505:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 506:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 507:Core/Src/navigation.c **** 	}
 508:Core/Src/navigation.c **** 	return 0;
 509:Core/Src/navigation.c **** }
