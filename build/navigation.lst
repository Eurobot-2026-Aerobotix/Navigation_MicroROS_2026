 613:Core/Src/navigation.c **** int go_to(float x, float y, float speed, int direction, int8_t is_smooth){
 614:Core/Src/navigation.c **** 	while(!is_idle()){
 615:Core/Src/navigation.c **** 		delay(10);
 616:Core/Src/navigation.c **** 	}
 617:Core/Src/navigation.c **** 	float angle = normalize_angle( get_angle_to(x, y) + PI*(1 - direction)/2 );
 618:Core/Src/navigation.c **** 	while (fabs(normalize_angle(angle - current_phi)) > deg_to_rad(1)){
 619:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 620:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 621:Core/Src/navigation.c **** 			return 0;
 622:Core/Src/navigation.c **** 		}
 623:Core/Src/navigation.c **** 		while(!is_idle()){
 624:Core/Src/navigation.c **** 			delay(10);
 625:Core/Src/navigation.c **** 		}
 626:Core/Src/navigation.c **** 		if (control_loop_state == SHUTDOWN ){
 627:Core/Src/navigation.c **** 			return 0;
 628:Core/Src/navigation.c **** 		}
 629:Core/Src/navigation.c **** 
 630:Core/Src/navigation.c **** 	}
 631:Core/Src/navigation.c **** 	delay(50);
 632:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 633:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 634:Core/Src/navigation.c **** 	}
 635:Core/Src/navigation.c **** 	return 0;
 636:Core/Src/navigation.c **** }
