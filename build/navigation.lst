 281:Core/Src/navigation.c **** int rotate(float angle, int8_t is_radian){
 282:Core/Src/navigation.c **** 	while(!is_idle()){
 283:Core/Src/navigation.c **** 		delay(10);
 284:Core/Src/navigation.c **** 	};
 285:Core/Src/navigation.c **** 	delay(200);
 286:Core/Src/navigation.c **** 	reset_speed_control_variables();
 287:Core/Src/navigation.c **** 	angle = is_radian? angle: deg_to_rad(angle);
 288:Core/Src/navigation.c **** 	float rotating_ramping_acceleration = MAX(300/(fabs(rad_to_deg(angle))/10.0 + 10), 10); // high ac
 289:Core/Src/navigation.c **** 	float rotating_breaking_acceleration = MIN(-120/(fabs(rad_to_deg(angle))/3.0 + 10), -4); // same l
 290:Core/Src/navigation.c **** 	float arc_length = (dead_wheels_spacing/2) * angle;
 291:Core/Src/navigation.c **** 
 292:Core/Src/navigation.c **** 	direction_R = SGN(arc_length);
 293:Core/Src/navigation.c **** 	direction_L = -direction_R;
 294:Core/Src/navigation.c **** 
 295:Core/Src/navigation.c **** 	// all of these formulas are derived from a ramp graph: speed = f(distance)
 296:Core/Src/navigation.c **** 	float speed = rotating_speed;
 297:Core/Src/navigation.c **** 	float distance = fabs(arc_length);
 298:Core/Src/navigation.c **** 	float x1 = speed/rotating_ramping_acceleration;
 299:Core/Src/navigation.c **** 	float x2 = speed/rotating_breaking_acceleration + distance;
 300:Core/Src/navigation.c **** 
 301:Core/Src/navigation.c **** 	if (x2 <= x1){ // correcting the cruising speed if it is too high to reach using the current ramp 
 302:Core/Src/navigation.c **** 		float intersection_x = (rotating_breaking_acceleration*distance)/(rotating_breaking_acceleration 
 303:Core/Src/navigation.c **** 		float intersection_speed = rotating_ramping_acceleration * intersection_x;
 304:Core/Src/navigation.c **** 		speed = 0.9 * intersection_speed;
 305:Core/Src/navigation.c **** 		x1 = speed/rotating_ramping_acceleration;
 306:Core/Src/navigation.c **** 		x2 = speed/rotating_breaking_acceleration + distance;
 307:Core/Src/navigation.c **** 	}
 308:Core/Src/navigation.c **** 	acc_linearization_coef = sqrt(x1);
 309:Core/Src/navigation.c **** 
 310:Core/Src/navigation.c **** 	cruise_speed_R = speed * direction_R;
 311:Core/Src/navigation.c **** 	cruise_speed_L = speed * direction_L;
 312:Core/Src/navigation.c **** 
 313:Core/Src/navigation.c **** 	// I will track only the right wheel cause both wheels need to be in sync
 314:Core/Src/navigation.c **** 	float distance_to_target = distance;
 315:Core/Src/navigation.c **** 	float previous_distance_to_target = distance;
 316:Core/Src/navigation.c **** 	float x;
 317:Core/Src/navigation.c **** 	float target_phi = absolute_phi + angle;
 318:Core/Src/navigation.c **** 
 319:Core/Src/navigation.c **** 	// Yaw centering, preventing that a wheel goes faster than the other and moves the rotation axis a
 320:Core/Src/navigation.c **** 	float distance_traveled_R;
 321:Core/Src/navigation.c **** 	float distance_traveled_L;
 322:Core/Src/navigation.c **** 	const int32_t starting_encoder_count_R = encoder_count_R;
 323:Core/Src/navigation.c **** 	const int32_t starting_encoder_count_L = encoder_count_L;
 324:Core/Src/navigation.c **** 	float yaw_centering_term;
 325:Core/Src/navigation.c **** 
 326:Core/Src/navigation.c **** 	float phase_two_angle = 6* (fabs(angle)/PI);
 327:Core/Src/navigation.c **** 
 328:Core/Src/navigation.c **** 	wheel_state_R = ACCELERATING;
 329:Core/Src/navigation.c **** 	wheel_state_L = ACCELERATING;
 330:Core/Src/navigation.c **** 	trajectory = ROTATING;
 331:Core/Src/navigation.c **** 	control_loop_state = SPEED;
 332:Core/Src/navigation.c **** 	while ( fabs(target_phi - absolute_phi) > deg_to_rad(phase_two_angle)  && !(distance_to_target > p
