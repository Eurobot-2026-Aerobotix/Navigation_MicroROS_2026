 522:Core/Src/navigation.c **** int go_to(float x, float y, float speed, int direction, int8_t is_smooth){
 523:Core/Src/navigation.c **** 	while(!is_idle()){
 524:Core/Src/navigation.c **** 		delay(10);
 525:Core/Src/navigation.c **** 	}
 526:Core/Src/navigation.c **** 	float angle = normalize_angle( get_angle_to(x, y) + PI*(1 - direction)/2 );
 527:Core/Src/navigation.c **** 	while (fabs(normalize_angle(angle - current_phi)) > deg_to_rad(1)){
 528:Core/Src/navigation.c **** 		orientate(angle, 1 , 0);
 529:Core/Src/navigation.c **** 		if(emergency_recieved == 1){
 530:Core/Src/navigation.c **** 			return 0;
 531:Core/Src/navigation.c **** 		}
 532:Core/Src/navigation.c **** 		while(!is_idle()){
 533:Core/Src/navigation.c **** 			delay(10);
 534:Core/Src/navigation.c **** 		}
 535:Core/Src/navigation.c **** 		if (control_loop_state == SHUTDOWN ){
 536:Core/Src/navigation.c **** 			return 0;
 537:Core/Src/navigation.c **** 		}
 538:Core/Src/navigation.c **** 
 539:Core/Src/navigation.c **** 	}
 540:Core/Src/navigation.c **** 	delay(50);
 541:Core/Src/navigation.c **** 	if (get_distance_to(x, y) > 2){
 542:Core/Src/navigation.c **** 		move_forward_full(direction * get_distance_to(x, y), speed, x, y, is_smooth);
 543:Core/Src/navigation.c **** 	}
 544:Core/Src/navigation.c **** 	return 0;
 545:Core/Src/navigation.c **** }
