 247:Core/Src/navigation.c **** int rotate(float angle, int8_t is_radian, int8_t is_smooth){
 248:Core/Src/navigation.c **** 	while(!is_idle()){
 249:Core/Src/navigation.c **** 		delay(10);
 250:Core/Src/navigation.c **** 	};
 251:Core/Src/navigation.c **** 	reset_speed_control_variables();
 252:Core/Src/navigation.c **** 	angle = is_radian? angle: deg_to_rad(angle);
 253:Core/Src/navigation.c **** 	float rotating_ramping_acceleration = MAX(200/(fabs(rad_to_deg(angle))/10.0 + 10), 10); // high ac
 254:Core/Src/navigation.c **** 	float rotating_breaking_acceleration = MIN(-120/(fabs(rad_to_deg(angle))/2.5 + 12), -2); // same l
 255:Core/Src/navigation.c **** 	float arc_length = (dead_wheels_spacing/2) * angle;
 256:Core/Src/navigation.c **** 
 257:Core/Src/navigation.c **** 	direction_R = SGN(arc_length);
 258:Core/Src/navigation.c **** 	direction_L = -direction_R;
 259:Core/Src/navigation.c **** 
 260:Core/Src/navigation.c **** 	// all of these formulas are derived from a ramp graph: speed = f(distance)
 261:Core/Src/navigation.c **** 	float speed = rotating_speed;
 262:Core/Src/navigation.c **** 	float distance = fabs(arc_length);
