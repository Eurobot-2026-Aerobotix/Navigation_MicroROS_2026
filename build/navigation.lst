  70:Core/Src/navigation.c **** 			return 0;
  71:Core/Src/navigation.c **** 		}
  72:Core/Src/navigation.c **** 
  73:Core/Src/navigation.c **** 		lane_correction_term = (calculate_instant_target_phi(x, distance) - absolute_phi) * 10; // the co
  74:Core/Src/navigation.c **** 		if (x < 0.1*x1){
  75:Core/Src/navigation.c **** 			lane_correction_term = 0;
  76:Core/Src/navigation.c **** 		}
