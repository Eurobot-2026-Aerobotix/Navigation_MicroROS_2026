 287:Core/Src/navigation.c **** int rotate(float angle, int8_t is_radian){
 288:Core/Src/navigation.c **** 	reset_speed_control_variables();
 289:Core/Src/navigation.c **** 	float rotating_breaking_acceleration = -4;
 290:Core/Src/navigation.c **** 	angle = is_radian? angle: deg_to_rad(angle);
 291:Core/Src/navigation.c **** 	float arc_length = (dead_wheels_spacing/2) * angle;
 292:Core/Src/navigation.c **** 
 293:Core/Src/navigation.c **** 	direction_R = SGN(arc_length);
 294:Core/Src/navigation.c **** 	direction_L = -direction_R;
 295:Core/Src/navigation.c **** 
 296:Core/Src/navigation.c **** 	// all of these formulas are derived from a ramp graph: speed = f(distance)
