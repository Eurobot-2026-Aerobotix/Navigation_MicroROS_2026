 274:Core/Src/main.c **** void publisher_task(void *argument) {
 275:Core/Src/main.c ****     geometry_msgs__msg__Vector3 pose_msg;
 276:Core/Src/main.c **** 
 277:Core/Src/main.c ****     for (;;) {
 278:Core/Src/main.c ****         // Get pose data
 279:Core/Src/main.c ****     	float pos[3];
 280:Core/Src/main.c ****     	get_position(pos);
 281:Core/Src/main.c ****     	pose_msg.x = pos[0]/1000.0;
 282:Core/Src/main.c ****     	pose_msg.y = pos[1]/1000.0;
 283:Core/Src/main.c ****     	pose_msg.z = pos[2];
 284:Core/Src/main.c **** 
 285:Core/Src/main.c ****         rcl_publish(&pose_publisher, &pose_msg, NULL);
 286:Core/Src/main.c ****         vTaskDelay(pdMS_TO_TICKS(70));  // Adjust as needed
 287:Core/Src/main.c ****     }
 288:Core/Src/main.c **** }
