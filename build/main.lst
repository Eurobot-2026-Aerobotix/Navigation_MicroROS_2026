 158:Core/Src/main.c **** void service_callback(const void *request_msg, void *response_msg) {
 159:Core/Src/main.c ****     service__srv__NaviStm_Request *req_in = (service__srv__NaviStm_Request *)request_msg;
 160:Core/Src/main.c ****     service__srv__NaviStm_Response *res_out = (service__srv__NaviStm_Response *)response_msg;
 161:Core/Src/main.c ****     communication_state = RASPBERRY;
 162:Core/Src/main.c **** 
 163:Core/Src/main.c ****     switch ((int)req_in->arg1) {
 164:Core/Src/main.c **** 									 case 4: //orientate
 165:Core/Src/main.c **** 										prepare_orientate(req_in->arg2, req_in->arg3, req_in->arg4);
 166:Core/Src/main.c **** 										res_out->result = true;  // orientation, is_radian
 167:Core/Src/main.c **** 										break;
 168:Core/Src/main.c **** 
 169:Core/Src/main.c **** 									 case 5: // go to
 170:Core/Src/main.c **** 										prepare_go_to(req_in->arg2, req_in->arg3, req_in->arg4, 1, req_in->arg5);
 171:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 172:Core/Src/main.c **** 										break;
 173:Core/Src/main.c **** 
 174:Core/Src/main.c **** 									 case 6: // Reset
 175:Core/Src/main.c **** 										prepare_reset();
 176:Core/Src/main.c **** 										res_out->result = true;
 177:Core/Src/main.c **** 										break;
 178:Core/Src/main.c **** 
 179:Core/Src/main.c **** 									 case 10: // emergency break
 180:Core/Src/main.c **** 										prepare_emergency_break();
 181:Core/Src/main.c **** 										res_out->result = true;
 182:Core/Src/main.c **** 										break;
 183:Core/Src/main.c **** 
 184:Core/Src/main.c **** 									 case 11: // is the robot idle
 185:Core/Src/main.c **** 										res_out->result = (robot_status.status == IDLE)? true: false;
 186:Core/Src/main.c **** 										break;
 187:Core/Src/main.c **** 
 188:Core/Src/main.c **** 									 case 12: // go to backwards
 189:Core/Src/main.c **** 										prepare_go_to(req_in->arg2, req_in->arg3, req_in->arg4, -1, req_in->arg5);
 190:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 191:Core/Src/main.c **** 										break;
 192:Core/Src/main.c **** 									 case 13: // bezier curve
 193:Core/Src/main.c **** 										prepare_bezier_curve(req_in->arg2, req_in->arg3, req_in->arg4, req_in->arg5, req_in->arg6
 194:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 195:Core/Src/main.c **** 										break;
 196:Core/Src/main.c **** 									 case 14: // bezier curve backwards
 197:Core/Src/main.c **** 										prepare_bezier_curve(req_in->arg2, req_in->arg3, req_in->arg4, req_in->arg5, req_in->arg6
 198:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 199:Core/Src/main.c **** 										break;
 200:Core/Src/main.c **** 									 case 15: // set_position
 201:Core/Src/main.c **** 										last_set_position_x = req_in->arg2;
ARM GAS  C:\Users\monji\AppData\Local\Temp\ccSudS80.s 			page 5


 202:Core/Src/main.c **** 										last_set_position_y = req_in->arg3;
 203:Core/Src/main.c **** 										last_set_position_phi = req_in->arg4;
 204:Core/Src/main.c **** 										prepare_set_position(req_in->arg2, req_in->arg3, req_in->arg4, req_in->arg4);
 205:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 206:Core/Src/main.c **** 										break;
 207:Core/Src/main.c **** 									 case 16:
 208:Core/Src/main.c **** 										 res_out->result = (
 209:Core/Src/main.c **** 												 	 	 		 (robot_status.status == IDLE)
 210:Core/Src/main.c **** 															 	 ||
 211:Core/Src/main.c **** 															 	 reached_destination
 212:Core/Src/main.c **** 															)? true: false;
 213:Core/Src/main.c **** 										 break;
 214:Core/Src/main.c **** 									 case 17://fix x and y
