 250:Core/Src/main.c **** 	pose_msg.z = pos[2];
 251:Core/Src/main.c **** 
 252:Core/Src/main.c **** 	rcl_publish(&pose_publisher, &pose_msg, NULL);
 253:Core/Src/main.c **** }
