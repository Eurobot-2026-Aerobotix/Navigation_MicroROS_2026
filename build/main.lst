  92:Core/Src/main.c ****     			    	  			    break;
  93:Core/Src/main.c **** 									 case 1:
  94:Core/Src/main.c **** 										command_waiting = 1;
  95:Core/Src/main.c **** 										first_forward_recieved = 1;
  96:Core/Src/main.c **** 										robot_status.status = MOVIN_FORWARD;
  97:Core/Src/main.c **** 										robot_status.arguments[0] = req_in->arg2;
