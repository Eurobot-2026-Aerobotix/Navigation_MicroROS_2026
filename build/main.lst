 212:Core/Src/main.c **** 										 float backup_x = req_in->arg3;
 213:Core/Src/main.c **** 										 float backup_y = req_in->arg4;
 214:Core/Src/main.c **** 										 float robot_phi = current_phi;
 215:Core/Src/main.c **** 										 //reset_everything();
 216:Core/Src/main.c **** 										 command_count = 0;
 217:Core/Src/main.c **** 										 robot_status.status = IDLE;
 218:Core/Src/main.c **** 										 if (!front1_back2){
 219:Core/Src/main.c **** 											reset_position();
 220:Core/Src/main.c **** 											set_position(backup_x, backup_y, rad_to_deg(robot_phi), rad_to_deg(robot_phi));
 221:Core/Src/main.c **** 										 }else if (front1_back2 == 1){
