 173:Core/Src/main.c **** 										prepare_reset();
 174:Core/Src/main.c **** 										res_out->result = true;
 175:Core/Src/main.c **** 										break;
 176:Core/Src/main.c **** 
 177:Core/Src/main.c **** 									 case 10: // emergency break
 178:Core/Src/main.c **** 										prepare_emergency_break();
 179:Core/Src/main.c **** 										res_out->result = true;
 180:Core/Src/main.c **** 										break;
 181:Core/Src/main.c **** 
 182:Core/Src/main.c **** 									 case 11: // is the robot idle
 183:Core/Src/main.c **** 										res_out->result = (robot_status.status == IDLE)? true: false;
 184:Core/Src/main.c **** 										break;
 185:Core/Src/main.c **** 
