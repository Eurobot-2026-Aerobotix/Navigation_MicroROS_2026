 123:Core/Src/main.c **** void service_callback(const void *request_msg, void *response_msg) {
 124:Core/Src/main.c ****     service__srv__NaviStm_Request *req_in = (service__srv__NaviStm_Request *)request_msg;
 125:Core/Src/main.c ****     service__srv__NaviStm_Response *res_out = (service__srv__NaviStm_Response *)response_msg;
 126:Core/Src/main.c ****     communication_state = RASPBERRY;
 127:Core/Src/main.c **** 
 128:Core/Src/main.c ****     switch ((int)req_in->arg1) {
 129:Core/Src/main.c **** 									 case 4: //orientate
 130:Core/Src/main.c **** 										prepare_orientate(req_in->arg2, req_in->arg3, req_in->arg4);
 131:Core/Src/main.c **** 										res_out->result = true;  // orientation, is_radian
 132:Core/Src/main.c **** 										break;
 133:Core/Src/main.c **** 
 134:Core/Src/main.c **** 									 case 5: // go to
 135:Core/Src/main.c **** 										prepare_go_to(req_in->arg2, req_in->arg3, req_in->arg4, 1, req_in->arg5);
 136:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 137:Core/Src/main.c **** 										break;
 138:Core/Src/main.c **** 
 139:Core/Src/main.c **** 									 case 6: // Reset
 140:Core/Src/main.c **** 										reset_everything();
 141:Core/Src/main.c **** 										res_out->result = true;
 142:Core/Src/main.c **** 										break;
 143:Core/Src/main.c **** 
 144:Core/Src/main.c **** 									 case 10: // emergency break
 145:Core/Src/main.c **** 										emergency_break();
