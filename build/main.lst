  79:Core/Src/main.c **** void service_callback(const void *request_msg, void *response_msg) {
  80:Core/Src/main.c ****     service__srv__NaviStm_Request *req_in = (service__srv__NaviStm_Request *)request_msg;
  81:Core/Src/main.c ****     service__srv__NaviStm_Response *res_out = (service__srv__NaviStm_Response *)response_msg;
  82:Core/Src/main.c ****     communication_state = RASPBERRY;
  83:Core/Src/main.c **** 
  84:Core/Src/main.c ****     switch ((int)req_in->arg1) {
  85:Core/Src/main.c ****     			    	  		    case 0 : // chihemmek feha test
  86:Core/Src/main.c ****     			    	  		    	for (int i = 0; i < 5; i++)  // Blink 10 times
  87:Core/Src/main.c ****     			    	  		    	{
  88:Core/Src/main.c ****     			    	  		    	    HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_5);
