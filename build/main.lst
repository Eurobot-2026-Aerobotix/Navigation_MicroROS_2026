1064:Core/Src/main.c **** void execute_every_n_ms(int64_t ms, SystemState system_state) {
1065:Core/Src/main.c ****     /* Method for periodically pinging the micro_ros_agent */
1066:Core/Src/main.c ****     do {
1067:Core/Src/main.c ****         static volatile int64_t init = -1;
1068:Core/Src/main.c ****         if (init == -1) {
1069:Core/Src/main.c ****             init = uxr_millis();
1070:Core/Src/main.c ****         }
1071:Core/Src/main.c ****         if (uxr_millis() - init > ms) {
1072:Core/Src/main.c ****             // system_state;
1073:Core/Src/main.c ****             init = uxr_millis();
1074:Core/Src/main.c ****         }
1075:Core/Src/main.c ****     }
1076:Core/Src/main.c ****     while (0);
1077:Core/Src/main.c **** }
