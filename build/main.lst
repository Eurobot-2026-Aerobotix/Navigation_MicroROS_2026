 125:Core/Src/main.c **** 										res_out->result = true;// distance, speed
 126:Core/Src/main.c **** 										break;
 127:Core/Src/main.c **** 
 128:Core/Src/main.c **** 									 case 2: // move backward
 129:Core/Src/main.c **** 										robot_status.status = MOVIN_BACKWARD;
 130:Core/Src/main.c **** 										robot_status.arguments[0] = req_in->arg2;
 131:Core/Src/main.c **** 										robot_status.arguments[1] = req_in->arg3;
 132:Core/Src/main.c **** 										res_out->result = true;  // distance, speed
 133:Core/Src/main.c **** 										break;
 134:Core/Src/main.c **** 
 135:Core/Src/main.c **** 									 case 3: // rotate
 136:Core/Src/main.c **** 										robot_status.status = ROTATIN;
 137:Core/Src/main.c **** 										robot_status.arguments[0] = req_in->arg2;
