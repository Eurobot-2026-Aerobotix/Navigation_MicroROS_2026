 197:Core/Src/main.c **** 									 case 16:
 198:Core/Src/main.c **** 										 res_out->result = (
 199:Core/Src/main.c **** 												 	 	 		 (robot_status.status == IDLE)
 200:Core/Src/main.c **** 															 	 ||
