 227:Core/Src/main.c **** void publisher_task(void *argument) {
 228:Core/Src/main.c ****     geometry_msgs__msg__Vector3 pose_msg;
 229:Core/Src/main.c **** 
 230:Core/Src/main.c ****     for (;;) {
 231:Core/Src/main.c ****         // Get pose data
 232:Core/Src/main.c ****     	float pos[3];
 233:Core/Src/main.c ****     	get_position(pos);
 234:Core/Src/main.c ****     	pose_msg.x = pos[0]/1000.0;
 235:Core/Src/main.c ****     	pose_msg.y = pos[1]/1000.0;
 236:Core/Src/main.c ****     	pose_msg.z = pos[2];
 237:Core/Src/main.c **** 
 238:Core/Src/main.c ****         rcl_publish(&pose_publisher, &pose_msg, NULL);
 239:Core/Src/main.c ****         vTaskDelay(pdMS_TO_TICKS(70));  // Adjust as needed
 240:Core/Src/main.c ****     }
 241:Core/Src/main.c **** }
