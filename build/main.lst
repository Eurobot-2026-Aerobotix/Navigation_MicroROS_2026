  99:Core/Src/main.c **** 										robot_status.arguments[2] = req_in->arg4;
 100:Core/Src/main.c **** 										res_out->result = true;// distance, speed
 101:Core/Src/main.c **** 										break;
 102:Core/Src/main.c **** 
 103:Core/Src/main.c **** 									 case 2: // move backward
 104:Core/Src/main.c **** 										command_waiting = 1;
 105:Core/Src/main.c **** 										robot_status.status = MOVIN_BACKWARD;
 106:Core/Src/main.c **** 										robot_status.arguments[0] = req_in->arg2;
 107:Core/Src/main.c **** 										robot_status.arguments[1] = req_in->arg3;
 108:Core/Src/main.c **** 										robot_status.arguments[2] = req_in->arg4;
 109:Core/Src/main.c **** 										res_out->result = true;  // distance, speed
 110:Core/Src/main.c **** 										break;
 111:Core/Src/main.c **** 
 112:Core/Src/main.c **** 									 case 3: // rotate
 113:Core/Src/main.c **** 										command_waiting = 1;
 114:Core/Src/main.c **** 										robot_status.status = ROTATIN;
 115:Core/Src/main.c **** 										robot_status.arguments[0] = req_in->arg2;
 116:Core/Src/main.c **** 										robot_status.arguments[1] = req_in->arg3;
 117:Core/Src/main.c **** 										robot_status.arguments[2] = req_in->arg4;
 118:Core/Src/main.c **** 										res_out->result = true; // angle, is_radian
 119:Core/Src/main.c **** 										break;
 120:Core/Src/main.c **** 
 121:Core/Src/main.c **** 									 case 4: //orientate
 122:Core/Src/main.c **** 										command_waiting = 1;
 123:Core/Src/main.c **** 										robot_status.status = ORIENTATIN;
