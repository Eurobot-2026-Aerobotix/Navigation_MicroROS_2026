 221:Core/Src/main.c **** 										 float back_aruco_y = req_in->arg4;
 222:Core/Src/main.c **** 										 float backup_x = req_in->arg3;
 223:Core/Src/main.c **** 										 float backup_y = req_in->arg4;
 224:Core/Src/main.c **** 										 float robot_phi = current_phi;
 225:Core/Src/main.c **** 										 //reset_everything();
 226:Core/Src/main.c **** 										 command_count = 0;
 227:Core/Src/main.c **** 										 robot_status.status = IDLE;
 228:Core/Src/main.c **** 										 if (!front1_back2){
 229:Core/Src/main.c **** 											reset_position();
 230:Core/Src/main.c **** 											set_position(backup_x, backup_y, rad_to_deg(robot_phi), rad_to_deg(robot_phi));
 231:Core/Src/main.c **** 										 }else if (front1_back2 == 1){
 232:Core/Src/main.c **** 											 float x = front_aruco_x + front_aruco_relative_y*sin(robot_phi) - front_aruco_relative_
 233:Core/Src/main.c **** 											 float y = front_aruco_y - front_aruco_relative_x*sin(robot_phi) - front_aruco_relative_
 234:Core/Src/main.c **** 											 set_position(x, y, rad_to_deg(robot_phi), rad_to_deg(robot_phi));
 235:Core/Src/main.c **** 										 }else{
 236:Core/Src/main.c **** 											 float x = back_aruco_x + back_aruco_relative_y*sin(robot_phi) - back_aruco_relative_x*c
 237:Core/Src/main.c **** 											 float y = back_aruco_y - back_aruco_relative_x*sin(robot_phi) - back_aruco_relative_y*c
 238:Core/Src/main.c **** 											 set_position(x, y, rad_to_deg(robot_phi), rad_to_deg(robot_phi));
 239:Core/Src/main.c **** 										 }
 240:Core/Src/main.c **** 										 control_loop_state = ACTIVATED;
 241:Core/Src/main.c **** 										 __enable_irq();
 242:Core/Src/main.c **** 										 res_out->result = true;
 243:Core/Src/main.c **** 										 break;
 244:Core/Src/main.c **** 									 case 18:
 245:Core/Src/main.c **** 										 res_out->result = stopped_because_of_collision? true: false;
 246:Core/Src/main.c **** 										 break;
 247:Core/Src/main.c **** 									 case 19: // shutdown
 248:Core/Src/main.c **** 										 shutdown();
 249:Core/Src/main.c **** 										 res_out->result = true;
 250:Core/Src/main.c **** 										 break;
 251:Core/Src/main.c **** 									 case 20: // creep to
 252:Core/Src/main.c **** 										 prepare_creep_to(req_in->arg2, req_in->arg3, 1);
 253:Core/Src/main.c **** 										 res_out->result = true;  // x, y, speed
 254:Core/Src/main.c **** 										 break;
 255:Core/Src/main.c **** 									 case 21: // creep to backwards
 256:Core/Src/main.c **** 										 prepare_creep_to(req_in->arg2, req_in->arg3, -1);
 257:Core/Src/main.c **** 										 res_out->result = true;  // x, y, speed
 258:Core/Src/main.c **** 										 break;
