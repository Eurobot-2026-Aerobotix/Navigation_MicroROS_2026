 206:Core/Src/main.c **** 										 control_loop_state = DISACTIVATED;
 207:Core/Src/main.c **** 										 float front1_back2 = req_in->arg2; // should be one if front aruco detected, 2 if back i
 208:Core/Src/main.c **** 										 float front_aruco_x = req_in->arg3;
 209:Core/Src/main.c **** 										 float front_aruco_y = req_in->arg4;
 210:Core/Src/main.c **** 										 float back_aruco_x = req_in->arg3;
