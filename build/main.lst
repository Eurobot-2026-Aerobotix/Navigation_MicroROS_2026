 223:Core/Src/main.c **** 											 float y = front_aruco_y - front_aruco_relative_x*sin(robot_phi) - front_aruco_relative_
 224:Core/Src/main.c **** 											 set_position(x, y, rad_to_deg(robot_phi), rad_to_deg(robot_phi));
 225:Core/Src/main.c **** 										 }else{
 226:Core/Src/main.c **** 											 float x = back_aruco_x + back_aruco_relative_y*sin(robot_phi) - back_aruco_relative_x*c
 227:Core/Src/main.c **** 											 float y = back_aruco_y - back_aruco_relative_x*sin(robot_phi) - back_aruco_relative_y*c
 228:Core/Src/main.c **** 											 set_position(x, y, rad_to_deg(robot_phi), rad_to_deg(robot_phi));
 229:Core/Src/main.c **** 										 }
 230:Core/Src/main.c **** 										 control_loop_state = ACTIVATED;
 231:Core/Src/main.c **** 										 __enable_irq();
 232:Core/Src/main.c **** 										 res_out->result = true;
 233:Core/Src/main.c **** 										 break;
 234:Core/Src/main.c **** 									 case 18:
 235:Core/Src/main.c **** 										 res_out->result = stopped_because_of_collision? true: false;
 236:Core/Src/main.c **** 										 break;
