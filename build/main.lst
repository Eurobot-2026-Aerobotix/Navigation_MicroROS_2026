 168:Core/Src/main.c **** 										break;
 169:Core/Src/main.c **** 									 case 16:
 170:Core/Src/main.c **** 										 res_out->result = ( (is_idle() && !complex_movement && !simple_movement && !command_wait
 171:Core/Src/main.c **** 										 break;
 172:Core/Src/main.c **** 									 case 17://fix x and y
 173:Core/Src/main.c **** 										 control_loop_state = DISACTIVATED;
 174:Core/Src/main.c **** 										 float saved_phi = current_phi;
 175:Core/Src/main.c **** 										 reset_everything();
 176:Core/Src/main.c **** 										 set_position(req_in->arg2, req_in->arg3, saved_phi, saved_phi);
