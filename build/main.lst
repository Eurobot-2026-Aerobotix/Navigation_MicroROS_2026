 147:Core/Src/main.c **** 										break;
 148:Core/Src/main.c **** 
 149:Core/Src/main.c **** 									 case 11: // is the robot idle
 150:Core/Src/main.c **** 										res_out->result = (is_idle() && !complex_movement && !simple_movement && !command_waiting
 151:Core/Src/main.c **** 										break;
 152:Core/Src/main.c **** 
