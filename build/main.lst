 135:Core/Src/main.c **** 										command_waiting = 1;
 136:Core/Src/main.c **** 										robot_status.status = MOVIN_BACKWARD;
 137:Core/Src/main.c **** 										robot_status.arguments[0] = req_in->arg2;
 138:Core/Src/main.c **** 										robot_status.arguments[1] = req_in->arg3;
 139:Core/Src/main.c **** 										robot_status.arguments[2] = req_in->arg4;
 140:Core/Src/main.c **** 										res_out->result = true;  // distance, speed
 141:Core/Src/main.c **** 										break;
