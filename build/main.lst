 192:Core/Src/main.c **** 										res_out->result = true; // distance, deviation, speed
 193:Core/Src/main.c **** 										break;
 194:Core/Src/main.c **** 
 195:Core/Src/main.c **** 									 case 9: // circle curve
 196:Core/Src/main.c **** 										robot_status.status = CIRCLE_CURVIN;
 197:Core/Src/main.c **** 										robot_status.arguments[0] = req_in->arg2;
 198:Core/Src/main.c **** 										robot_status.arguments[1] = req_in->arg3;
