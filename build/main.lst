 162:Core/Src/main.c **** 										break;
 163:Core/Src/main.c **** 
 164:Core/Src/main.c **** 									 case 6: // Reset
 165:Core/Src/main.c **** 										prepare_reset();
 166:Core/Src/main.c **** 										res_out->result = true;
 167:Core/Src/main.c **** 										break;
 168:Core/Src/main.c **** 
 169:Core/Src/main.c **** 									 case 10: // emergency break
 170:Core/Src/main.c **** 										prepare_emergency_break();
 171:Core/Src/main.c **** 										res_out->result = true;
 172:Core/Src/main.c **** 										break;
 173:Core/Src/main.c **** 
 174:Core/Src/main.c **** 									 case 11: // is the robot idle
 175:Core/Src/main.c **** 										res_out->result = (robot_status.status == IDLE)? true: false;
 176:Core/Src/main.c **** 										break;
 177:Core/Src/main.c **** 
 178:Core/Src/main.c **** 									 case 12: // go to backwards
 179:Core/Src/main.c **** 										prepare_go_to(req_in->arg2, req_in->arg3, req_in->arg4, -1, req_in->arg5);
 180:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 181:Core/Src/main.c **** 										break;
 182:Core/Src/main.c **** 									 case 13: // bezier curve
 183:Core/Src/main.c **** 										prepare_bezier_curve(req_in->arg2, req_in->arg3, req_in->arg4, req_in->arg5, req_in->arg6
 184:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 185:Core/Src/main.c **** 										break;
 186:Core/Src/main.c **** 									 case 14: // bezier curve backwards
 187:Core/Src/main.c **** 										prepare_bezier_curve(req_in->arg2, req_in->arg3, req_in->arg4, req_in->arg5, req_in->arg6
 188:Core/Src/main.c **** 										res_out->result = true;  // x, y, speed
 189:Core/Src/main.c **** 										break;
 190:Core/Src/main.c **** 									 case 15: // set_position
 191:Core/Src/main.c **** 										last_set_position_x = req_in->arg2;
 192:Core/Src/main.c **** 										last_set_position_y = req_in->arg3;
