  41:Core/Src/Odometry.c **** void update_position(int8_t skip){
  42:Core/Src/Odometry.c **** 	if (!skip){
  43:Core/Src/Odometry.c **** 		update_encoder_counts();
  44:Core/Src/Odometry.c **** 
  45:Core/Src/Odometry.c **** 		float dR = ticks_to_distance(encoder_count_R - previous_encoder_count_R, wheel_diameter_R);
  46:Core/Src/Odometry.c **** 		float dL = ticks_to_distance(encoder_count_L - previous_encoder_count_L, wheel_diameter_L);
  47:Core/Src/Odometry.c **** 		float dC = (dR+dL)/2;
  48:Core/Src/Odometry.c **** 
  49:Core/Src/Odometry.c **** 		float previous_absolute_phi = absolute_phi;
  50:Core/Src/Odometry.c **** 		absolute_phi = ( ticks_to_distance(encoder_count_R, wheel_diameter_R) - ticks_to_distance(encoder
  51:Core/Src/Odometry.c **** 
  52:Core/Src/Odometry.c **** 		//current_x += dC*cos( ( previous_absolute_phi + absolute_phi ) / 2 );
  53:Core/Src/Odometry.c **** 		//current_y += dC*sin( ( previous_absolute_phi + absolute_phi ) / 2 );
  54:Core/Src/Odometry.c **** 
  55:Core/Src/Odometry.c **** 		current_x += dC*cos(previous_absolute_phi);
  56:Core/Src/Odometry.c **** 		current_y += dC*sin(previous_absolute_phi);
  57:Core/Src/Odometry.c **** 
  58:Core/Src/Odometry.c **** 		current_phi = absolute_phi;
  59:Core/Src/Odometry.c **** 		while (current_phi > PI){
  60:Core/Src/Odometry.c **** 			current_phi -= 2*PI;
  61:Core/Src/Odometry.c **** 		}
  62:Core/Src/Odometry.c **** 		while (current_phi <= -PI){
  63:Core/Src/Odometry.c **** 			current_phi += 2*PI;
  64:Core/Src/Odometry.c **** 		}
  65:Core/Src/Odometry.c **** 
  66:Core/Src/Odometry.c **** 		update_speed();
  67:Core/Src/Odometry.c **** 	}
  68:Core/Src/Odometry.c **** }
  69:Core/Src/Odometry.c **** void reset_position(){
  70:Core/Src/Odometry.c **** 	set_position(0, 0, 0, 0);
  71:Core/Src/Odometry.c **** }
  72:Core/Src/Odometry.c **** void set_position(float current__x, float current__y, float current__phi, float absolute__phi){
  73:Core/Src/Odometry.c **** 	current__phi = deg_to_rad(current__phi);
  74:Core/Src/Odometry.c **** 	absolute__phi = deg_to_rad(absolute__phi);
  75:Core/Src/Odometry.c **** 	current_x = current__x;
  76:Core/Src/Odometry.c **** 	current_y = current__y;
  77:Core/Src/Odometry.c **** 	current_phi = current__phi;
  78:Core/Src/Odometry.c **** 	absolute_phi = absolute__phi;
  79:Core/Src/Odometry.c **** 	encoder_count_R = (CPR * absolute__phi * dead_wheels_spacing/2) / (wheel_diameter_R * PI);
  80:Core/Src/Odometry.c **** 	encoder_count_L = -(CPR * absolute__phi * dead_wheels_spacing/2) / (wheel_diameter_L * PI);
  81:Core/Src/Odometry.c **** 	previous_encoder_count_L = encoder_count_L;
  82:Core/Src/Odometry.c **** 	previous_encoder_count_R = encoder_count_R;
  83:Core/Src/Odometry.c **** 	reset_position_control_variables();
  84:Core/Src/Odometry.c **** 	target_encoder_count_R = encoder_count_R;
  85:Core/Src/Odometry.c **** 	target_encoder_count_L = encoder_count_L;
  86:Core/Src/Odometry.c **** 	position_integral_R = 0;
  87:Core/Src/Odometry.c **** 	position_derivative_R = 0;
  88:Core/Src/Odometry.c **** 	position_integral_L = 0;
  89:Core/Src/Odometry.c **** 	position_derivative_L = 0;
  90:Core/Src/Odometry.c **** }
