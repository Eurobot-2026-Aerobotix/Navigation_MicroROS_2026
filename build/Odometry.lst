   8:Core/Src/Odometry.c **** #include "../Inc/Odometry.h"
   9:Core/Src/Odometry.c **** 
  10:Core/Src/Odometry.c **** float driven_wheels_spacing;
  11:Core/Src/Odometry.c **** float dead_wheels_spacing;
  12:Core/Src/Odometry.c **** float current_x = 0;
  13:Core/Src/Odometry.c **** float current_y = 0;
  14:Core/Src/Odometry.c **** float current_phi = 0;
  15:Core/Src/Odometry.c **** float absolute_phi = 0;
  16:Core/Src/Odometry.c **** 
  17:Core/Src/Odometry.c **** void update_position(){
  18:Core/Src/Odometry.c **** 
  19:Core/Src/Odometry.c **** 	float dR = ticks_to_distance(encoder_count_R - previous_encoder_count_R, wheel_diameter_R);
  20:Core/Src/Odometry.c **** 	float dL = ticks_to_distance(encoder_count_L - previous_encoder_count_L, wheel_diameter_L);
  21:Core/Src/Odometry.c **** 	float dC = (dR+dL)/2;
  22:Core/Src/Odometry.c **** 
  23:Core/Src/Odometry.c **** 	current_x += dC*cos(current_phi);
  24:Core/Src/Odometry.c **** 	current_y += dC*sin(current_phi);
  25:Core/Src/Odometry.c **** 	float d_phi = ((dR-dL)/dead_wheels_spacing);
  26:Core/Src/Odometry.c **** 	current_phi += d_phi;
  27:Core/Src/Odometry.c **** 	absolute_phi += d_phi;
  28:Core/Src/Odometry.c **** 
  29:Core/Src/Odometry.c **** 	while (current_phi > PI){
  30:Core/Src/Odometry.c **** 		current_phi -= 2*PI;
ARM GAS  C:\Users\monji\AppData\Local\Temp\cciFzo0O.s 			page 2


  31:Core/Src/Odometry.c **** 	}
  32:Core/Src/Odometry.c **** 	while (current_phi <= -PI){
  33:Core/Src/Odometry.c **** 		current_phi += 2*PI;
  34:Core/Src/Odometry.c **** 	}
  35:Core/Src/Odometry.c **** 
  36:Core/Src/Odometry.c **** 	update_speed();
  37:Core/Src/Odometry.c **** }
