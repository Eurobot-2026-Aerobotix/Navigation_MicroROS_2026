 101:Core/Src/Odometry.c **** 
 102:Core/Src/Odometry.c **** void update_position(void)
 103:Core/Src/Odometry.c **** {
 104:Core/Src/Odometry.c **** 	read_right_encoder();
 105:Core/Src/Odometry.c **** 	read_left_encoder();
 106:Core/Src/Odometry.c **** 	dR = ticks_to_distance(d_right,right_radius,right_resolution,right_precision);
 107:Core/Src/Odometry.c **** 	//dR=-dR;
 108:Core/Src/Odometry.c **** 	//dL=-dL;
 109:Core/Src/Odometry.c **** 	total_right += dR;
 110:Core/Src/Odometry.c **** 	d_right_counter += dR;
 111:Core/Src/Odometry.c **** 	dL = ticks_to_distance(d_left,left_radius,left_resolution,left_precision);
 112:Core/Src/Odometry.c **** 	total_left += dL;
 113:Core/Src/Odometry.c **** 	d_left_counter += dL;
 114:Core/Src/Odometry.c **** 	dC = (dR+dL)/2;
 115:Core/Src/Odometry.c **** 	total_centre+=dC;
 116:Core/Src/Odometry.c **** 
 117:Core/Src/Odometry.c **** 	current_x = current_x + RL_b_sens * dC*cos(current_phi_rad);
 118:Core/Src/Odometry.c **** 	current_y = current_y + RL_b_sens * dC*sin(current_phi_rad);
 119:Core/Src/Odometry.c **** 	current_phi_rad += ((dR-dL)/spacing_encoder);
 120:Core/Src/Odometry.c **** 	d_phi_counter += ((dR-dL)/spacing_encoder);
 121:Core/Src/Odometry.c **** 	while (current_phi_rad>PI)
 122:Core/Src/Odometry.c **** 	{
 123:Core/Src/Odometry.c **** 		current_phi_rad -= 2*PI;
 124:Core/Src/Odometry.c **** 	}
 125:Core/Src/Odometry.c **** 	while (current_phi_rad<-PI)
 126:Core/Src/Odometry.c **** 	{
 127:Core/Src/Odometry.c **** 		current_phi_rad += 2*PI;
 128:Core/Src/Odometry.c **** 	}
 129:Core/Src/Odometry.c **** 	current_phi_deg = rad_to_deg(current_phi_rad);
 130:Core/Src/Odometry.c **** 	//Robot navi 2020
 131:Core/Src/Odometry.c **** 	millis++;
 132:Core/Src/Odometry.c **** 	t++;
 133:Core/Src/Odometry.c **** 	//ref_x = current_x + cos(current_phi_rad) *dec;
 134:Core/Src/Odometry.c **** 	//ref_y = current_y + sin(current_phi_rad) *dec;
 135:Core/Src/Odometry.c **** }
