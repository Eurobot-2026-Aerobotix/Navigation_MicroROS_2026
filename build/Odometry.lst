   8:Core/Src/odometry.c **** #include "../Inc/odometry.h"
   9:Core/Src/odometry.c **** 
  10:Core/Src/odometry.c **** float driven_wheels_spacing;
  11:Core/Src/odometry.c **** float dead_wheels_spacing;
  12:Core/Src/odometry.c **** float current_x = 0;
  13:Core/Src/odometry.c **** float current_y = 0;
  14:Core/Src/odometry.c **** float current_phi = 0;
  15:Core/Src/odometry.c **** float absolute_phi = 0;
  16:Core/Src/odometry.c **** 
  17:Core/Src/odometry.c **** void update_position(){
  18:Core/Src/odometry.c **** 	float dR = ticks_to_distance(encoder_count_R - previous_encoder_count_R, wheel_diameter_R);
  19:Core/Src/odometry.c **** 	float dL = ticks_to_distance(encoder_count_L - previous_encoder_count_L, wheel_diameter_L);
  20:Core/Src/odometry.c **** 	float dC = (dR+dL)/2;
  21:Core/Src/odometry.c **** 
  22:Core/Src/odometry.c **** 	current_x += dC*cos(current_phi);
  23:Core/Src/odometry.c **** 	current_y += dC*sin(current_phi);
  24:Core/Src/odometry.c **** 	float d_phi = ((dR-dL)/dead_wheels_spacing);
  25:Core/Src/odometry.c **** 	current_phi += d_phi;
  26:Core/Src/odometry.c **** 	absolute_phi += d_phi;
  27:Core/Src/odometry.c **** 
  28:Core/Src/odometry.c **** 	while (current_phi > PI){
  29:Core/Src/odometry.c **** 		current_phi -= 2*PI;
  30:Core/Src/odometry.c **** 	}
ARM GAS  /var/folders/8w/hhxpmw5s5nq9vy9lt9w1v2xh0000gn/T//ccxPCtOV.s 			page 2


  31:Core/Src/odometry.c **** 	while (current_phi <= -PI){
  32:Core/Src/odometry.c **** 		current_phi += 2*PI;
  33:Core/Src/odometry.c **** 	}
  34:Core/Src/odometry.c **** 	update_speed();
  35:Core/Src/odometry.c **** }
