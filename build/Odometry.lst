  69:Core/Src/Odometry.c **** void set_position(float current__x, float current__y, float current__phi, float absolute__phi){
  70:Core/Src/Odometry.c **** 	current__phi = deg_to_rad(current__phi);
  71:Core/Src/Odometry.c **** 	absolute__phi = deg_to_rad(absolute__phi);
  72:Core/Src/Odometry.c **** 	current_x = current__x;
  73:Core/Src/Odometry.c **** 	current_y = current__y;
  74:Core/Src/Odometry.c **** 	current_phi = current__phi;
  75:Core/Src/Odometry.c **** 	absolute_phi = absolute__phi;
  76:Core/Src/Odometry.c **** 	encoder_count_R = (CPR * absolute__phi * dead_wheels_spacing/2) / (wheel_diameter_R * PI);
  77:Core/Src/Odometry.c **** 	encoder_count_L = -(CPR * absolute__phi * dead_wheels_spacing/2) / (wheel_diameter_L * PI);
  78:Core/Src/Odometry.c **** 	previous_encoder_count_L = encoder_count_L;
  79:Core/Src/Odometry.c **** 	previous_encoder_count_R = encoder_count_R;
  80:Core/Src/Odometry.c **** 	reset_position_control_variables();
  81:Core/Src/Odometry.c **** 	target_encoder_count_R = encoder_count_R;
  82:Core/Src/Odometry.c **** 	target_encoder_count_L = encoder_count_L;
  83:Core/Src/Odometry.c **** 	position_integral_R = 0;
